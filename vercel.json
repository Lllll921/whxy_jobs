{
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/jobs.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" }
  ],
  "crons": [
    {
      "path": "/api/jobs?refresh=1",
      "schedule": "0 21 * * *"
    }
  ]
}
